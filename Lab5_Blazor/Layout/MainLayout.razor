@inherits LayoutComponentBase

<div class="d-flex text-white" style="min-height: 100vh; background-color: #030303;">
    <!-- Бокове меню -->
    <div class="p-3" style="width: 250px; background-color: #050505; border-right: 1px solid #0a2e14;">
        <h4 class="mb-4 text-center mt-2" style="font-weight: 800; letter-spacing: 1px;">OOP <span style="color: #156b33;">LAB</span></h4>
        <hr style="border-color: #156b33; opacity: 0.5;" />
        <nav class="nav flex-column gap-3 mt-4">
            <NavLink class="nav-link text-white rounded cyber-nav" href="" Match="NavLinkMatch.All">
                [ 0 ] Головна
            </NavLink>
            <NavLink class="nav-link text-white rounded cyber-nav" href="race">
                [ 1 ] Забіг
            </NavLink>
            <NavLink class="nav-link text-white rounded cyber-nav" href="voronoi">
                [ 2 ] Вороной
            </NavLink>
            <NavLink class="nav-link text-white rounded cyber-nav" href="tower-defense">
                [ 3 ] HIGHWAY DEFENSE
            </NavLink>
        </nav>
    </div>

    <!-- Основний контент-->
    <main class="flex-grow-1 p-0" style="overflow: hidden;">
        @Body
    </main>
</div>

<style>
    .cyber-nav {
        transition: all 0.3s ease;
        font-family: monospace;
        font-size: 1.1rem;
    }
    .cyber-nav:hover, .cyber-nav.active {
        background-color: rgba(21, 107, 51, 0.15);
        box-shadow: inset 4px 0 0 #156b33;
        transform: translateX(5px);
    }
</style>