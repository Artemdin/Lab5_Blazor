@page "/tower-defense"
@using Lab5_Blazor.GameLogic
@using System.Globalization
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="racing-td">
    <header class="hud-bar">
        <div class="hud-brand">
            <span class="icon">🏁</span> HIGHWAY DEFENSE <span class="sub">LAB 5</span>
        </div>

        <div class="hud-stats">
            <div class="stat-badge">
                <span class="label">БЮДЖЕТ:</span>
                <span class="value cash">$@GameManager.Gold</span>
            </div>
            <div class="stat-badge">
                <span class="label">ХВИЛЯ:</span>
                <span class="value wave">@GameManager.CurrentWave</span>
            </div>
            <div class="stat-badge">
                <span class="label">РАХУНОК:</span>
                <span class="value score">@GameManager.Score</span>
            </div>
        </div>

        <div class="hud-controls">
            <button class="ctrl-btn action-btn @(IsRunning ? "danger" : "ready")" @onclick="StartWave" disabled="@IsGameOver">
                @(IsRunning ? "🛑 ЗУПИНИТИ" : "🚀 ПУСК ХВИЛІ")
            </button>
            <button class="ctrl-btn reset-btn" @onclick="ResetGame">🔄 СКИНУТИ</button>
        </div>
    </header>

    <main class="arena-wrap">
        <section class="battlefield">
            <div class="map-status">@WaveMessage</div>

            @* Додано @ref="svgElement" та @onmousemove:stopPropagation *@
            <svg @ref="svgElement" class="game-svg" viewBox="0 0 1200 700" xmlns="http://www.w3.org/2000/svg"
                 @onclick="OnMapClick" @onmousemove="UpdateCursorPosition" @onmousemove:stopPropagation>
                <defs>
                    <filter id="drop-shadow">
                        <feDropShadow dx="2" dy="4" stdDeviation="3" flood-opacity="0.4" />
                    </filter>
                </defs>

                <rect width="1200" height="700" fill="#4e8752" />

                <path d="M 0 330 L 260 330 L 260 170 L 920 170 L 920 520 L 1200 520"
                      stroke="#2d3134" stroke-width="68" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                
                <path d="M 0 330 L 260 330 L 260 170 L 920 170 L 920 520 L 1200 520"
                      stroke="#adb5bd" stroke-width="74" fill="none" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.3;" />

                <path d="M 0 330 L 260 330 L 260 170 L 920 170 L 920 520 L 1200 520"
                      stroke="#ffffff" stroke-width="4" fill="none" stroke-dasharray="20 15" stroke-linecap="butt" stroke-linejoin="round" />

                <rect x="0" y="296" width="15" height="68" fill="#ffc107" />
                <rect x="1185" y="486" width="15" height="68" fill="#dc3545" />

                @foreach (var shot in ActiveShots)
                {
                    <line x1="@SvgNum(shot.X1)" y1="@SvgNum(shot.Y1)" x2="@SvgNum(shot.X2)" y2="@SvgNum(shot.Y2)"
                          stroke="#00ffff" stroke-width="4" style="opacity:@SvgNum(shot.Opacity);" stroke-linecap="round" />
                    <circle cx="@SvgNum(shot.X2)" cy="@SvgNum(shot.Y2)" r="8" fill="#00ffff" style="opacity:@SvgNum(shot.Opacity);" />
                }

                @foreach (var tower in Towers)
                {
                    <g class="tower-group @(SelectedTower == tower ? "selected" : "")"
                           transform="translate(@SvgNum(tower.X), @SvgNum(tower.Y))"
                           @onclick:stopPropagation="true" @onclick="() => SelectTower(tower)" filter="url(#drop-shadow)">

                        <circle class="range-ring" r="@tower.Range" />
                        <circle r="22" fill="#adb5bd" stroke="#495057" stroke-width="3" />
                        <circle cx="-7" cy="-7" r="5" fill="#0d6efd" />
                        <circle cx="7" cy="7" r="5" fill="#dc3545" />
                        <circle r="10" fill="#212529" stroke="#ffc107" stroke-width="2" />
                        <rect x="-2" y="-20" width="4" height="12" fill="#ffc107" />

                        <svg:text x="0" y="4" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle" style="pointer-events: none;">@tower.Level</svg:text>
                    </g>
                }

                @foreach (var enemy in Enemies.Where(e => !e.HasEscaped))
                {
                    <g class="enemy-car" transform="translate(@SvgNum(enemy.X), @SvgNum(enemy.Y)) rotate(@SvgNum(enemy.Angle))" filter="url(#drop-shadow)">
                        @if (enemy.IsBoss)
                        {
                            <rect x="-26" y="-14" width="52" height="28" fill="#212529" rx="4" stroke="#ffc107" stroke-width="2" />
                            <rect x="8" y="-12" width="16" height="24" fill="#495057" rx="2" />
                            <rect x="12" y="-10" width="6" height="20" fill="#0dcaf0" />
                            <rect x="24" y="-12" width="3" height="5" fill="#ffff00" />
                            <rect x="24" y="7" width="3" height="5" fill="#ffff00" />
                        }
                        else
                        {
                            string carColor = enemy.MaxHP > 60 ? "#dc3545" : (enemy.MaxHP > 40 ? "#fd7e14" : "#6f42c1");
                            <rect x="-16" y="-10" width="32" height="20" fill="@carColor" rx="5" />
                            <rect x="-4" y="-8" width="14" height="16" fill="#212529" rx="3" />
                            <rect x="2" y="-7" width="6" height="14" fill="#0dcaf0" opacity="0.8" />
                            <rect x="14" y="-8" width="3" height="4" fill="#ffff00" />
                            <rect x="14" y="4" width="3" height="4" fill="#ffff00" />
                        }
                    </g>
                    
                    <g transform="translate(@SvgNum(enemy.X), @SvgNum(enemy.Y))">
                        <rect x="-18" y="-28" width="36" height="6" fill="rgba(0,0,0,0.6)" rx="3" />
                        <rect x="-18" y="-28" width="@SvgNum((enemy.DisplayHP / enemy.MaxHP) * 36)" height="6" fill="@(enemy.IsBoss ? "#ffc107" : "#00ff88")" rx="3" style="transition: width 0.1s;" />
                    </g>
                }

                @foreach (var pop in DamagePopups)
                {
                    <svg:text x="@SvgNum(pop.X)" y="@SvgNum(pop.Y)" class="damage-fx" style="opacity:@SvgNum(pop.Opacity);">
                        -@pop.Amount
                    </svg:text>
                }
            </svg>

            @if (PlacingTower)
            {
                <div class="build-cursor" style="left:@($"{CursorXPercent:F2}%"); top:@($"{CursorYPercent:F2}%");">
                    <div class="cursor-ring"></div>
                </div>
            }

            @if (IsGameOver)
            {
                <div class="game-over-overlay">
                    <h2>ПРОГРАШ</h2>
                    <p>Машинка прорвала оборону!</p>
                    <button class="ctrl-btn reset-btn" style="font-size: 1.1rem; padding: 12px 24px;" @onclick="ResetGame">🔄 СПРОБУВАТИ ЗНОВУ</button>
                </div>
            }
        </section>

        <aside class="sys-panel">
            <div class="panel-header">
                <h3>🛠 УПРАВЛІННЯ</h3>
            </div>

            <div class="shop-card">
                <div class="info">
                    <h4>Поліцейський пост</h4>
                    <p>Атакує порушників EMP-зарядами.</p>
                </div>
                <button class="buy-btn @(PlacingTower ? "active" : "")" @onclick="TogglePlacement">
                    @(PlacingTower ? "◉ СКАСУВАТИ" : "🛒 КУПИТИ ($50)")
                </button>
            </div>

            <div class="game-info">
                <p>💡 <em>Клікніть на газон, щоб встановити пост. Будувати на асфальті заборонено. Можна ставити пости поруч.</em></p>
                <hr />
                <div class="stat-row"><span>Всього постів:</span> <strong>@Towers.Count</strong></div>
                <div class="stat-row"><span>Машин на трасі:</span> <strong style="color: #dc3545;">@Enemies.Count(e => !e.IsDead && !e.HasEscaped)</strong></div>
            </div>

            @if (SelectedTower != null)
            {
                <div class="upgrade-card">
                    <h4>Обраний пост (Рівень @SelectedTower.Level)</h4>
                    <div class="stat-row"><span>Радіус:</span> <strong>@SelectedTower.Range</strong></div>
                    <div class="stat-row"><span>Швидкість:</span> <strong>@SelectedTower.FireRate.ToString("F1") /с</strong></div>
                    <button class="upgrade-btn" @onclick="UpgradeSelectedTower">
                        ⬆ ПОКРАЩИТИ ($50)
                    </button>
                </div>
            }
        </aside>
    </main>
</div>

@code {
    private GameManager GameManager { get; set; } = new();
    private List<TowerViewModel> Towers { get; set; } = new();
    private List<Enemy> Enemies { get; set; } = new();
    private List<ShotViewModel> ActiveShots { get; set; } = new();

    private TowerViewModel? SelectedTower;
    private bool IsRunning = false;
    private bool IsGameOver = false;
    private bool PlacingTower = false;
    private double CursorX = 450;
    private double CursorY = 280;
    private string WaveMessage = "Траса вільна. Побудуйте захисні пости.";
    private const double MapWidth = 1200.0;
    private const double MapHeight = 700.0;
    
    // Посилання на SVG елемент
    private ElementReference svgElement;

    private static readonly (double X, double Y)[] EnemyPath =
    {
        (0, 330), (260, 330), (260, 170), (920, 170), (920, 520), (1200, 520)
    };

    private CancellationTokenSource? _cts;

    private class TowerViewModel : Tower
    {
        public double X { get; set; }
        public double Y { get; set; }
        public DateTime LastShotAt { get; set; } = DateTime.MinValue;
    }

    private class ShotViewModel
    {
        public double X1, Y1, X2, Y2;
        public int Life { get; set; } = 5;
        public int MaxLife { get; set; } = 5;
        public double Opacity => MaxLife == 0 ? 0 : (double)Life / MaxLife;
    }

    private class DamagePopupViewModel
    {
        public double X { get; set; }
        public double Y { get; set; }
        public int Amount { get; set; }
        public int Life { get; set; } = 14;
        public int MaxLife { get; set; } = 14;
        public double Opacity => MaxLife == 0 ? 0 : (double)Life / MaxLife;
    }
    private List<DamagePopupViewModel> DamagePopups { get; set; } = new();

    private double CursorXPercent => Math.Clamp((CursorX / MapWidth) * 100.0, 0, 100);
    private double CursorYPercent => Math.Clamp((CursorY / MapHeight) * 100.0, 0, 100);

    // Новий метод для оновлення позиції курсору через JS
    private async Task UpdateCursorPosition(MouseEventArgs e)
    {
        var svgPoint = await JSRuntime.InvokeAsync<SvgPoint>("gameHelper.getSvgPoint", svgElement, e.ClientX, e.ClientY);
        CursorX = Math.Clamp(svgPoint.X, 0, MapWidth);
        CursorY = Math.Clamp(svgPoint.Y, 0, MapHeight);
    }

    // Клас для отримання точних координат з JS
    public class SvgPoint
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    private async Task OnMapClick(MouseEventArgs e)
    {
        // Оновлюємо координати перед кліком, про всяк випадок
        await UpdateCursorPosition(e);
        
        if (!PlacingTower) return;

        const int towerCost = 50;
        if (GameManager.Gold < towerCost)
        {
            WaveMessage = $"❌ Недостатньо коштів у бюджеті (${towerCost}).";
            return;
        }

        if (IsPointOnRoad(CursorX, CursorY))
        {
            WaveMessage = "⚠️ Неможливо розмістити пост на проїжджій частині!";
            return;
        }

        var tower = new TowerViewModel
        {
            X = Math.Clamp(CursorX, 24, MapWidth - 24),
            Y = Math.Clamp(CursorY, 24, MapHeight - 24)
        };

        // ПЕРЕВІРКУ КОЛІЗІЙ ВИДАЛЕНО, щоб можна було ставити пости один на одного.

        GameManager.Gold -= towerCost;
        Towers.Add(tower);
        PlacingTower = false;
        WaveMessage = $"👮 Пост встановлено [{tower.X:F0}; {tower.Y:F0}]";
    }

    private void SelectTower(TowerViewModel t)
    {
        SelectedTower = SelectedTower == t ? null : t;
    }

    private void TogglePlacement()
    {
        if (IsGameOver) return;
        PlacingTower = !PlacingTower;
        WaveMessage = PlacingTower ? "📍 Оберіть локацію для розміщення посту." : "Побудову скасовано.";
    }

    private async void StartWave()
    {
        if (IsGameOver) return;

        if (IsRunning)
        {
            _cts?.Cancel();
            IsRunning = false;
            WaveMessage = $"Хвилю {GameManager.CurrentWave} зупинено.";
            return;
        }

        _cts = new CancellationTokenSource();
        IsRunning = true;
        GameManager.CurrentWave++;
        WaveMessage = $"🚗 Хвиля {GameManager.CurrentWave} розпочалась! Увага на трасу.";

        var isBossWave = GameManager.CurrentWave % 4 == 0;
        var enemiesToSpawn = isBossWave ? GameManager.CurrentWave - 1 : GameManager.CurrentWave + 2;

        const double spawnSpacing = 45.0;
        for (int i = 0; i < enemiesToSpawn; i++)
        {
            Enemies.Add(new Enemy
            {
                X = EnemyPath[0].X - (i * spawnSpacing),
                Y = EnemyPath[0].Y,
                HP = 60 + (GameManager.CurrentWave * 10),
                MaxHP = 60 + (GameManager.CurrentWave * 10),
                DisplayHP = 60 + (GameManager.CurrentWave * 10),
                PathPointIndex = 1
            });
        }

        if (isBossWave)
        {
            Enemies.Add(new Enemy
            {
                X = EnemyPath[0].X - ((enemiesToSpawn + 1) * spawnSpacing),
                Y = EnemyPath[0].Y,
                IsBoss = true,
                HP = 400 + (GameManager.CurrentWave * 80),
                MaxHP = 400 + (GameManager.CurrentWave * 80),
                DisplayHP = 400 + (GameManager.CurrentWave * 80),
                PathPointIndex = 1
            });
            WaveMessage = $"⚠️ УВАГА! На трасу виїхав броньований тягач!";
        }

        StateHasChanged();
        await RunWaveLoop(_cts.Token);
    }

    private async Task RunWaveLoop(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested &&
                   (Enemies.Any(e => !e.HasEscaped && !e.IsDead) ||
                    Enemies.Any(e => !e.HasEscaped && e.DisplayHP > 0)))
            {
                foreach (var e in Enemies.Where(e => !e.IsDead && !e.HasEscaped))
                {
                    MoveEnemyAlongPath(e);
                    if (e.HasEscaped)
                    {
                        IsGameOver = true;
                        PlacingTower = false;
                        WaveMessage = "💥 ПРОГРАШ! Машинка прорвала оборону!";
                        _cts?.Cancel();
                        break;
                    }
                }

                foreach (var shot in ActiveShots) { shot.Life--; }
                ActiveShots.RemoveAll(s => s.Life <= 0);

                foreach (var pop in DamagePopups)
                {
                    pop.Life--;
                    pop.Y -= 1.0;
                }
                DamagePopups.RemoveAll(p => p.Life <= 0);

                foreach (var tower in Towers)
                {
                    var fireCooldownMs = 1000.0 / Math.Max(0.4, tower.FireRate);
                    if ((DateTime.UtcNow - tower.LastShotAt).TotalMilliseconds < fireCooldownMs) continue;

                    foreach (var enemy in Enemies.Where(e => !e.IsDead && !e.HasEscaped))
                    {
                        if (CollisionHelper.IsHit(tower.X, tower.Y, enemy.X, enemy.Y, tower.Range))
                        {
                            tower.LastShotAt = DateTime.UtcNow;
                            var damage = (int)(45 + (tower.Level * 15));
                            enemy.HP -= damage;
                            
                            DamagePopups.Add(new DamagePopupViewModel
                            {
                                X = enemy.X,
                                Y = enemy.Y - 15,
                                Amount = damage
                            });
                            
                            ActiveShots.Add(new ShotViewModel
                            {
                                X1 = tower.X,
                                Y1 = tower.Y,
                                X2 = enemy.X,
                                Y2 = enemy.Y
                            });

                            if (enemy.IsDead)
                            {
                                GameManager.ProcessEnemyDeath(enemy.IsBoss);
                            }
                            break;
                        }
                    }
                }

                foreach (var enemy in Enemies.Where(e => !e.HasEscaped))
                {
                    enemy.DisplayHP = Math.Max(enemy.HP, enemy.DisplayHP - 8);
                }

                Enemies.RemoveAll(e => e.HasEscaped || (e.IsDead && e.DisplayHP <= 0));
                await InvokeAsync(StateHasChanged);
                await Task.Delay(30, ct);
            }
        }
        catch (TaskCanceledException) { }

        ActiveShots.Clear();
        DamagePopups.Clear();
        IsRunning = false;
        
        if (!IsGameOver)
        {
            WaveMessage = $"🏁 Раунд {GameManager.CurrentWave} завершено!";
        }
        await InvokeAsync(StateHasChanged);
    }

    private void UpgradeSelectedTower()
    {
        if (SelectedTower == null) return;
        const int upgradeCost = 50;
        if (GameManager.Gold < upgradeCost)
        {
            WaveMessage = $"❌ Недостатньо коштів для модернізації (${upgradeCost}).";
            return;
        }
        GameManager.LevelUpTower(SelectedTower);
        WaveMessage = $"⚡ Пост модернізовано до {SelectedTower.Level} рівня.";
    }

    private void ResetGame()
    {
        _cts?.Cancel();
        GameManager = new GameManager();
        Towers.Clear();
        Enemies.Clear();
        ActiveShots.Clear();
        DamagePopups.Clear();
        IsRunning = false;
        IsGameOver = false;
        SelectedTower = null;
        WaveMessage = "🔄 Систему перезапущено. Готово до старту.";
    }

    private bool IsPointOnRoad(double x, double y)
    {
        const double roadHalfWidth = 38.0;
        for (int i = 0; i < EnemyPath.Length - 1; i++)
        {
            if (DistanceToSegment(x, y, EnemyPath[i].X, EnemyPath[i].Y, EnemyPath[i + 1].X, EnemyPath[i + 1].Y) <= roadHalfWidth)
            {
                return true;
            }
        }
        return false;
    }

    private void MoveEnemyAlongPath(Enemy enemy)
    {
        if (enemy.PathPointIndex >= EnemyPath.Length)
        {
            enemy.HasEscaped = true;
            return;
        }

        var target = EnemyPath[enemy.PathPointIndex];
        var speed = enemy.IsBoss ? 1.4 : 2.6;
        var dx = target.X - enemy.X;
        var dy = target.Y - enemy.Y;
        var distance = Math.Sqrt((dx * dx) + (dy * dy));

        if (distance > 0.1)
        {
            enemy.Angle = Math.Atan2(dy, dx) * (180.0 / Math.PI);
        }

        if (distance <= speed || distance < 0.01)
        {
            enemy.X = target.X;
            enemy.Y = target.Y;
            enemy.PathPointIndex++;
            if (enemy.PathPointIndex >= EnemyPath.Length)
            {
                enemy.HasEscaped = true;
            }
            return;
        }

        enemy.X += (dx / distance) * speed;
        enemy.Y += (dy / distance) * speed;
    }

    private static double DistanceToSegment(double px, double py, double x1, double y1, double x2, double y2)
    {
        var dx = x2 - x1;
        var dy = y2 - y1;
        if (Math.Abs(dx) < 0.001 && Math.Abs(dy) < 0.001)
        {
            return Math.Sqrt(((px - x1) * (px - x1)) + ((py - y1) * (py - y1)));
        }
        var t = ((px - x1) * dx + (py - y1) * dy) / ((dx * dx) + (dy * dy));
        t = Math.Clamp(t, 0, 1);
        return Math.Sqrt(Math.Pow(px - (x1 + t * dx), 2) + Math.Pow(py - (y1 + t * dy), 2));
    }

    private static string SvgNum(double value) => value.ToString("F2", CultureInfo.InvariantCulture);

    public void Dispose() => _cts?.Cancel();
}