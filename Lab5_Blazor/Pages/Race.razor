@page "/race"
@using Lab5_Blazor.Services
@using Lab5_Blazor.Models
@inject RaceEngine Engine
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Redline JDM Casino</PageTitle>

<div class="jdm-race-theme">
    <div class="scanlines"></div>

    @* ВЕРХНЯ ПАНЕЛЬ*@
    <div class="casino-header glass-panel">
        <div class="header-left">
            <button class="btn-back" @onclick="GoHome" title="Return to Main Menu">
                <span class="back-arrow">←</span> HOME
            </button>
            <div class="header-title">
                <span class="title-accent">REDLINE</span> BOOKMAKER
            </div>
        </div>
        
        <div class="header-stats">
            <div class="balance-container">
                <span class="label">BALANCE</span>
                <span class="value">$@Engine.UserBalance.ToString("F0")</span>
            </div>

            @if (_showResults && _lastProfit != 0)
            {
                <div class="profit-indicator @(_lastProfit > 0 ? "profit" : "loss")">
                    @(_lastProfit > 0 ? "+" : "")$@_lastProfit.ToString("F0")
                </div>
            }
        </div>
    </div>

    @* ОСНОВНИЙ КОНТЕЙНЕР (ТРАСА ЗЛІВА, СТАВКИ СПРАВА)  *@
    <div class="main-casino-layout">
        
        <div class="race-content-column">
            
            @* ТРАСА *@
            <div class="track-area glass-panel" style="background-image: url('images/track_bg.png');">
                @if (Engine.CurrentWeather == Weather.Rain)
                {
                    <div class="weather-rain"></div>
                }
                else if (Engine.CurrentWeather == Weather.Snow)
                {

                    <div class="weather-snow"></div>
                }

                <div class="speed-lines @(Engine.IsRacing ? "active" : "")"></div>

                @{
                    var leaderPos = Engine.Participants.Any() ? Engine.Participants.Max(v => v.Position) : 0;
                    var leaderPct = Math.Min(100.0, (leaderPos / _trackLen) * 100.0);
                    var startOpacity = Math.Max(0, 1.0 - (leaderPct / 10.0));
                    var startOffset = -(leaderPct * 5);
                    var finishOpacity = leaderPct < 80 ? 0 : Math.Min(1.0, (leaderPct - 80) / 20.0);
                    var finishOffset = Math.Max(0, (100 - leaderPct) * 3);
                }

                <div class="start-line" style="opacity: @startOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture); transform: translateX(@(startOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))px);">START</div>
                <div class="finish-zone" style="opacity: @finishOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture); transform: translateX(@(finishOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))px);">FINISH</div>

                @for (int i = 0; i < Engine.Participants.Count; i++)
                {
                    var v = Engine.Participants[i];
                    var pct = Math.Min(100.0, (v.Position / _trackLen) * 100.0);
                    <div class="track-lane">
                        <div class="car-container" style="left: @(pct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; transform: translateX(-@(pct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%);">
                            @if (v.IsBroken)
                            {
                                <div class="alert-badge warning-pulse">FAIL</div>
                            }
                            <img src="images/cars/car@(i + 1).png" class="car-img @(v.IsBroken ? "broken-fx" : "")" />
                            <div class="car-shadow" style="background: @v.Color;"></div>
                        </div>
                    </div>
                }
            </div>

            @* СТАТИСТИКА*@
            <div class="glass-panel stats-dashboard">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>POS</th>
                            <th>CAR MODEL</th>
                            <th>SPEED</th>
                            <th>STATUS</th>
                            <th>TIME</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rankedParticipants = Engine.Participants
                                .OrderByDescending(v => v.Position >= _trackLen && !v.IsBroken)
                                .ThenBy(v => v.Position >= _trackLen && !v.IsBroken ? v.RaceTime : TimeSpan.MaxValue)
                                .ThenByDescending(v => v.Position)
                                .ToList();
                        }
                        @for (int i = 0; i < rankedParticipants.Count; i++)
                        {
                            var v = rankedParticipants[i];
                            var isFinished = v.Position >= _trackLen && !v.IsBroken;
                            var liveSpeed = (Engine.IsRacing && !v.IsBroken && !isFinished) ? Math.Round(v.Speed * v.Acceleration * 6) : 0;
                            string positionBadge = isFinished ? (i == 0 ? "🏆 1ST" : i == 1 ? "🥈 2ND" : i == 2 ? "🥉 3RD" : $"{i + 1}th") : "-";

                            <tr class="@(isFinished && i == 0 ? "row-winner" : isFinished ? "row-success" : v.IsBroken ? "row-danger" : "")">
                                <td class="pos-cell">
                                    <span class="rank-badge @(i == 0 ? "rank-gold" : i == 1 ? "rank-silver" : i == 2 ? "rank-bronze" : "rank-none")">@positionBadge</span>
                                </td>
                                <td><div class="car-name-cell"><span class="color-dot" style="background: @v.Color;"></span>@v.Name</div></td>
                                <td class="digital-text">@liveSpeed <span class="unit">km/h</span></td>
                                <td><span class="status-badge @(isFinished ? "badge-success" : v.IsBroken ? "badge-danger" : Engine.IsRacing ? "badge-racing" : "badge-idle")">@(isFinished ? "FINISHED" : v.IsBroken ? "BROKEN" : Engine.IsRacing ? "RACING..." : "READY")</span></td>
                                <td class="digital-text">@(v.RaceTime.TotalSeconds > 0 ? v.RaceTime.ToString(@"mm\:ss\.fff") : "--:--.---")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

        @* ПАНЕЛЬ СТАВОК *@
        <div class="sidebar-betting-column glass-panel">
            <div class="sidebar-header">
                BETTING SLIP
            </div>

            <div class="sidebar-controls">
                <div class="control-block">
                    <label class="control-label">WEATHER CONDITION</label>
                    <div class="input-group">
                        <span class="input-icon">🌤️</span>
                        <select class="premium-input select-fixed" @bind="Engine.CurrentWeather" disabled="@Engine.IsRacing">
                            <option value="@Weather.Sunny">SUNNY (Fast)</option>
                            <option value="@Weather.Rain">RAIN (Medium)</option>
                            <option value="@Weather.Snow">SNOW (High Risk)</option>
                        </select>
                    </div>
                </div>
                
                <div class="control-block">
                    <label class="control-label">SELECT VEHICLE</label>
                    <div class="input-group">
                        <span class="input-icon">🏎️</span>
                        <select class="premium-input select-fixed" @bind="_selectedCarIndex" disabled="@Engine.IsRacing">
                            @for (int i = 0; i < Engine.Participants.Count; i++)
                            {
                                <option value="@i">@($"{Engine.Participants[i].Name} (x{Engine.Participants[i].WinCoefficient:F2})")</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="control-block">
                    <label class="control-label">STAKE AMOUNT ($)</label>
                    <div class="input-group">
                        <span class="input-icon">💰</span>
                        <input type="number" class="premium-input input-fixed"
                               @bind="_betAmount"
                               min="10" step="50"
                               disabled="@Engine.IsRacing"
                               placeholder="Amount" />
                    </div>
                </div>

                <button class="btn-glow full-width-btn btn-place-bet" @onclick="AddBet" disabled="@(Engine.IsRacing || Engine.UserBalance < _betAmount)">
                    ADD TO SLIP
                </button>
            </div>

            @* Фішки активних ставок у сайдбарі *@
            <div class="active-slips-container">
                <div class="slips-header">ACTIVE BETS (@_activeBets.Count)</div>
                <div class="slips-list">
                    @if (_activeBets.Any())
                    {
                        @foreach (var bet in _activeBets)
                        {
                            <div class="slip-item" style="border-left-color: @Engine.Participants[bet.Key].Color">
                                <div class="slip-info">
                                    <span class="slip-car">@Engine.Participants[bet.Key].Name</span>
                                    <span class="slip-odds">x@(Engine.Participants[bet.Key].WinCoefficient.ToString("F2"))</span>
                                </div>
                                <div class="slip-amount">$@bet.Value</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-slips">No active bets placed</div>
                    }
                </div>
            </div>

            <div class="sidebar-actions">
                <button class="btn-solid full-width-btn btn-reset" @onclick="ResetRace" disabled="@Engine.IsRacing">RESET</button>
                <button class="btn-glow full-width-btn btn-start" @onclick="StartRace" disabled="@(Engine.IsRacing || !_activeBets.Any())">START RACE</button>
            </div>
        </div>

    </div>
</div>

@code {
    private const double _trackLen = 1000;
    private int _betAmount = 100;
    private int _selectedCarIndex = 0;
    private Dictionary<int, int> _activeBets = new();
    private bool _showResults = false;
    private decimal _lastProfit = 0;

    private static readonly string[] _carNames = { "Toyota Supra MK4", "BMW M3 E46", "Audi R8", "Mazda RX-7 FD", "Nissan Skyline R34" };
    private static readonly string[] _carColors = { "#ff003c", "#0088ff", "#ffffff", "#ffaa00", "#00ff66" };

    protected override void OnInitialized()
    {
        Engine.OnStateChanged += Refresh;
        if (Engine.Participants.Count == 0)
        {
            Engine.Participants = Enumerable.Range(0, 5)
                .Select(i => new Vehicle(_carNames[i], _carColors[i]))
                .ToList();
        }
    }

    private void GoHome()
    {
        NavManager.NavigateTo("/");
    }

    private void AddBet()
    {
        if (Engine.IsRacing || Engine.UserBalance < _betAmount) return;

        if (_activeBets.ContainsKey(_selectedCarIndex))
            _activeBets[_selectedCarIndex] += _betAmount;
        else
            _activeBets.Add(_selectedCarIndex, _betAmount);

        Engine.UserBalance -= _betAmount;
        _showResults = false;
    }

    private async Task StartRace()
    {
        if (Engine.IsRacing || !_activeBets.Any()) return;

        _showResults = false;
        decimal totalStaked = _activeBets.Sum(b => b.Value);
        
        await Engine.StartRace(_trackLen);

        var winner = Engine.Participants
            .Where(v => v.Position >= _trackLen && !v.IsBroken)
            .OrderBy(v => v.RaceTime)
            .FirstOrDefault();

        decimal totalWon = 0;
        if (winner != null)
        {
            int winnerIdx = Engine.Participants.IndexOf(winner);
            if (_activeBets.TryGetValue(winnerIdx, out int winBet))
            {
                totalWon = (decimal)winBet * (decimal)winner.WinCoefficient;
                Engine.UserBalance += totalWon;
            }
        }

        _lastProfit = totalWon - totalStaked;
        _activeBets.Clear();
        _showResults = true;
    }

    private void ResetRace()
    {
        if (Engine.IsRacing) return;
        Engine.ResetRace();
        _activeBets.Clear();
        _showResults = false;
        foreach (var car in Engine.Participants) car.GenerateNewStats();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.OnStateChanged -= Refresh;
}