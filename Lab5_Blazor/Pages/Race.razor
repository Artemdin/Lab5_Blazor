@page "/race"
@using Lab5_Blazor.Services
@using Lab5_Blazor.Models
@inject RaceEngine Engine
@implements IDisposable

<PageTitle>Redline JDM Racing</PageTitle>

<div class="jdm-race-theme">
    <div class="scanlines"></div>

    @* ─── ПАНЕЛЬ КЕРУВАННЯ ТА СТАВОК (HUD) ─── *@
    <div class="glass-panel control-dashboard">
        <div class="balance-widget">
            <div class="widget-label">CURRENT BALANCE</div>
            <div class="money-text">$@Engine.UserBalance.ToString("F0")</div>
        </div>
        
        <div class="betting-controls">
            <div class="input-wrapper">
                <span class="input-icon">🌤️</span>
                <select class="premium-input" @bind="Engine.CurrentWeather" disabled="@Engine.IsRacing">
                    <option value="@Weather.Sunny">SUNNY (Clear / Fast)</option>
                    <option value="@Weather.Rain">RAIN (Wet / Medium Risk)</option>
                    <option value="@Weather.Snow">SNOW STORM (Ice / High Risk)</option>
                </select>
            </div>
            
            <div class="input-wrapper">
                <span class="input-icon">💰</span>
                <input type="number" class="premium-input"
                       @bind="_betAmount"
                       min="50" step="50"
                       disabled="@(Engine.IsRacing || _betPlaced)"
                       placeholder="Bet $" />
            </div>
            
            <div class="input-wrapper">
                <span class="input-icon">🏎️</span>
                <select class="premium-input" @bind="_betCarIndex" disabled="@Engine.IsRacing">
                    @for (int i = 0; i < Engine.Participants.Count; i++)
                    {
                        <option value="@i">@($"{Engine.Participants[i].Name} (x{Engine.Participants[i].WinCoefficient:F2})")</option>
                    }
                </select>
            </div>
            
            <button class="btn-glow btn-place-bet" @onclick="PlaceBet" disabled="@(Engine.IsRacing || _betPlaced)">
                @(_betPlaced ? "✓ PLACED" : "PLACE BET")
            </button>
        </div>

        <div class="action-buttons">
            <button class="btn-solid btn-reset" @onclick="ResetRace" disabled="@Engine.IsRacing">RESET</button>
            <button class="btn-glow btn-start" @onclick="StartRace" disabled="@Engine.IsRacing">START RACE</button>
        </div>
    </div>

    @* ─── ТРАСА ─── *@
    <div class="track-area glass-panel" style="background-image: url('images/track_bg.png');">
        
        @* Погодні ефекти *@
        @if (Engine.CurrentWeather == Weather.Rain)
        {
            <div class="weather-rain"></div>
        }
        else if (Engine.CurrentWeather == Weather.Snow)
        {
            <div class="weather-snow"></div>
        }

        <div class="speed-lines @(Engine.IsRacing ? "active" : "")"></div>

        @{
            var leaderPos = Engine.Participants.Any() ? Engine.Participants.Max(v => v.Position) : 0;
            var leaderPct = Math.Min(100.0, (leaderPos / _trackLen) * 100.0);
            
            var startOpacity = Math.Max(0, 1.0 - (leaderPct / 10.0));
            var startOffset = -(leaderPct * 5);
            
            var finishOpacity = leaderPct < 80 ? 0 : Math.Min(1.0, (leaderPct - 80) / 20.0);
            var finishOffset = Math.Max(0, (100 - leaderPct) * 3);
        }

        <div class="start-line"
             style="opacity: @(startOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
            transform: translateX(@(startOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))px);">
            START
        </div>
        
        <div class="finish-zone"
             style="opacity: @(finishOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
            transform: translateX(@(finishOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))px);">
            FINISH
        </div>

        @for (int i = 0; i < Engine.Participants.Count; i++)
        {
            var v = Engine.Participants[i];
            var pct = Math.Min(100.0, (v.Position / _trackLen) * 100.0);
            
            <div class="track-lane">
                <div class="car-container"
                     style="left: @(pct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%;
                    transform: translateX(-@(pct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%);">
                    
                    @if (v.IsBroken)
                    {
                        <div class="alert-badge warning-pulse">FAILURE</div>
                    }
                    <img src="images/cars/car@(i + 1).png" class="car-img @(v.IsBroken ? "broken-fx" : "")" />
                    
                    <div class="car-shadow" style="background: @v.Color;"></div>
                </div>
            </div>
        }
    </div>

    @* ─── СТАТИСТИКА ─── *@
    <div class="glass-panel stats-dashboard">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>POS</th>
                    <th>CAR MODEL</th>
                    <th>SPEED</th>
                    <th>STATUS</th>
                    <th>TIME</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rankedParticipants = Engine.Participants
                        .OrderByDescending(v => v.Position >= _trackLen && !v.IsBroken)
                        .ThenBy(v => v.Position >= _trackLen && !v.IsBroken ? v.RaceTime : TimeSpan.MaxValue)
                        .ThenByDescending(v => v.Position)
                        .ToList();
                }
                
                @for (int i = 0; i < rankedParticipants.Count; i++)
                {
                    var v = rankedParticipants[i];
                    var isFinished = v.Position >= _trackLen && !v.IsBroken;
                    var liveSpeed = (Engine.IsRacing && !v.IsBroken && !isFinished)
                                    ? Math.Round(v.Speed * v.Acceleration * 6) : 0;
                    
                    string positionBadge = "-";
                    if (isFinished)
                    {
                        if (i == 0) positionBadge = "🏆 1ST";
                        else if (i == 1) positionBadge = "🥈 2ND";
                        else if (i == 2) positionBadge = "🥉 3RD";
                        else positionBadge = $"{i + 1}th";
                    }

                    <tr class="@(isFinished && i == 0 ? "row-winner" : isFinished ? "row-success" : v.IsBroken ? "row-danger" : "")">
                        <td class="pos-cell">
                            @if (positionBadge != "-")
                            {
                                <span class="rank-badge @(i == 0 ? "rank-gold" : i == 1 ? "rank-silver" : i == 2 ? "rank-bronze" : "")">
                                    @positionBadge
                                </span>
                            }
                            else
                            {
                                <span class="rank-badge rank-none">-</span>
                            }
                        </td>
                        <td>
                            <div class="car-name-cell">
                                <span class="color-dot" style="background: @v.Color; box-shadow: 0 0 8px @v.Color;"></span>
                                @v.Name
                            </div>
                        </td>
                        <td class="digital-text">@liveSpeed <span class="unit">km/h</span></td>
                        <td>
                            @if (isFinished)
                            {
                                <span class="status-badge badge-success">FINISHED</span>
                            }
                            else if (v.IsBroken)
                            {

                                <span class="status-badge badge-danger">BROKEN</span>
                            }
                            else if (Engine.IsRacing)
                            {

                                <span class="status-badge badge-racing">RACING...</span>
                            }
                            else
                            {

                                <span class="status-badge badge-idle">READY</span>
                            }
                        </td>
                        <td class="digital-text">@(v.RaceTime.TotalSeconds > 0 ? v.RaceTime.ToString(@"mm\:ss\.fff") : "--:--.---")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private const double _trackLen = 1000;
    private int _betAmount = 100;
    private int _betCarIndex = 0;
    private bool _betPlaced = false;

    private static readonly string[] _carNames = { "Toyota Supra MK4", "BMW M3 E46", "Audi R8", "Mazda RX-7 FD", "Nissan Skyline R34" };
    private static readonly string[] _carColors = { "#ff003c", "#0088ff", "#ffffff", "#ffaa00", "#00ff66" };

    protected override void OnInitialized()
    {
        Engine.OnStateChanged += Refresh;
        if (Engine.Participants.Count == 0)
        {
            Engine.Participants = Enumerable.Range(0, 5)
                .Select(i => new Vehicle(_carNames[i], _carColors[i]))
                .ToList();
        }
    }

    private async Task StartRace()
    {
        if (Engine.IsRacing) return;
        
        await Engine.StartRace(_trackLen);

        if (_betPlaced)
        {
            var betCar = Engine.Participants[_betCarIndex];
            
            var realWinner = Engine.Participants
                .Where(v => v.Position >= _trackLen && !v.IsBroken)
                .OrderBy(v => v.RaceTime)
                .FirstOrDefault();

            var tjomchikWinner = Engine.Participants
                .OrderByDescending(v => v.Position)
                .FirstOrDefault();

            //  Корегуємо баланс
            if (realWinner == betCar && tjomchikWinner != betCar)
            {
                Engine.UserBalance += (decimal)_betAmount * (decimal)betCar.WinCoefficient;
            }
            else if (realWinner != betCar && tjomchikWinner == betCar)
            {
                Engine.UserBalance -= (decimal)_betAmount * (decimal)betCar.WinCoefficient;
            }
        }

        _betPlaced = false;
    }

    private void PlaceBet()
    {
        if (_betPlaced || Engine.Participants.Count == 0) return;
        var car = Engine.Participants[_betCarIndex];
        Engine.PlaceBet(car, (decimal)_betAmount);
        _betPlaced = true;
    }

    private void ResetRace()
    {
        if (Engine.IsRacing) return;
        Engine.ResetRace();
        
        // Оновлюємо статки для кожної гонки
        foreach (var car in Engine.Participants)
        {
            car.GenerateNewStats();
        }
        
        _betPlaced = false;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.OnStateChanged -= Refresh;
}